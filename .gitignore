.DS_Store
.p10k.zsh
.config/kitty/kitty.conf.backup
.config/kitty/kitty.conf.improved

# tmux: TPM bootstraps plugins from .tmux.conf on first run
.tmux/plugins/

# zellij: wasm plugins fetched from upstream; too large for dotfiles
.config/zellij/plugins/*.wasm

# pi (agent harness): only AGENTS.md + selected skills/prompts tracked
.pi/*
!.pi/agent/
.pi/agent/*
!.pi/agent/AGENTS.md
!.pi/agent/APPEND_SYSTEM.md
!.pi/agent/prompts/
!.pi/agent/skills/
.pi/agent/skills/*
!.pi/agent/skills/worktree/
!.pi/agent/skills/humanizer/
